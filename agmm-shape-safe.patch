+# SPDX-License-Identifier: Apache-2.0
+"""Fuse graph-visible AG + GEMM; preserve all AG consumers and token cropping."""
+from __future__ import annotations
+import operator
+import torch
+from vllm.compilation.passes.vllm_inductor_pass import VllmInductorPass
+from vllm.distributed import get_tensor_model_parallel_world_size, get_tp_group
+from vllm.logger import logger
+from vllm_ascend import envs
+from vllm_ascend.device.device_config import is_950
+from vllm_ascend.ops import agmm  # register opaque ops before graph rewriting
+
+_AG = torch.ops.vllm.all_gather.default
+_MM = torch.ops.vllm.unquantized_gemm.default
+
+def _is_op(target, overload):
+    return target is overload or target is overload.overloadpacket
+
+def _normalize_metadata(graph):
+    for node in graph.nodes:
+        if 'val' not in node.meta and 'example_value' in node.meta:
+            node.meta['val'] = node.meta['example_value']
+
+
+def _metadata(node, value):
+    from torch.fx.passes.shape_prop import _extract_tensor_metadata
+    from torch.utils._pytree import tree_map
+    meta = dict(node.meta)
+    meta["val"] = value
+    if "tensor_meta" in meta:
+        meta["tensor_meta"] = tree_map(_extract_tensor_metadata, value)
+    if "example_value" in meta:
+        meta["example_value"] = value
+    return meta
+
+
+def _slice_source(node):
+    if node.target == operator.getitem and len(node.args) == 2:
+        index = node.args[1]
+        if isinstance(index, slice) and index.start in (None, 0) and index.step in (None, 1):
+            return node.args[0], index.stop
+    if _is_op(node.target, torch.ops.aten.slice.Tensor):
+        args = node.args
+        if len(args) >= 4 and args[1] == 0 and args[2] == 0 and (len(args) < 5 or args[4] == 1):
+            return args[0], args[3]
+    return None
+
+
+def rewrite_bf16(graph_module, group_name, world_size, hcom, min_tokens, comm_mode):
+    graph = graph_module.graph if hasattr(graph_module, "graph") else graph_module
+    _normalize_metadata(graph)
+    matched = 0
+    for gather in list(graph.nodes):
+        if gather.op != "call_function" or not _is_op(gather.target, _AG):
+            continue
+        if len(gather.args) < 3 or gather.args[1] != 0 or gather.args[2] != world_size:
+            continue
+        name = gather.args[3] if len(gather.args) > 3 else gather.kwargs.get("group_name")
+        if name != group_name:
+            continue
+        candidates = []
+        for user in gather.users:
+            source = _slice_source(user) if user.op == "call_function" else None
+            if source and source[0] is gather:
+                candidates.extend((mm, source[1]) for mm in user.users if mm.op == "call_function" and _is_op(mm.target, _MM) and mm.args[0] is user)
+            elif user.op == "call_function" and _is_op(user.target, _MM) and user.args[0] is gather:
+                candidates.append((user, None))
+        valid = []
+        for mm, end in candidates:
+            x = gather.args[0].meta.get("val");w = mm.args[1].meta.get("val")
+            if not isinstance(x, torch.Tensor) or not isinstance(w, torch.Tensor):
+                continue
+            if x.ndim != 2 or w.ndim != 2 or x.dtype not in (torch.bfloat16, torch.float16) or x.dtype != w.dtype or w.shape[0]<256:
+                continue
+            if not isinstance(w.shape[0], int) or not isinstance(w.shape[1], int) or x.shape[1] != w.shape[1]:
+                continue
+            # Weight/bias must be available before AG, not derived from its output.
+            bias = mm.args[2] if len(mm.args) > 2 else mm.kwargs.get("bias")
+            if bias is not None or mm.meta.get("stream_label") != gather.meta.get("stream_label"):
+                continue
+            before = list(graph.nodes)[:list(graph.nodes).index(gather)]
+            if mm.args[1] not in before or (isinstance(bias, torch.fx.Node) and bias not in before):
+                continue
+            valid.append((mm, end, bias, w.shape[0]))
+        if not valid:
+            continue
+        mm, end, bias, _ = max(valid, key=lambda c:c[3])
+        with graph.inserting_before(gather):
+            fused = graph.call_function(torch.ops.vllm.ascend_agmm_bf16.default,
+                args=(gather.args[0], mm.args[1], bias, group_name, world_size, hcom, min_tokens, comm_mode))
+            y = graph.call_function(operator.getitem, args=(fused, 0))
+            full = graph.call_function(operator.getitem, args=(fused, 1))
+        y_value = agmm._bf16_fake(gather.args[0].meta["val"], mm.args[1].meta["val"], None,
+            group_name, world_size, hcom, min_tokens, comm_mode)[0]
+        fused.meta = _metadata(mm,(y_value,gather.meta["val"]))
+        y.meta = _metadata(mm,y_value)
+        full.meta = dict(gather.meta)
+        gather.replace_all_uses_with(full)
+        if end is not None:
+            with graph.inserting_before(mm):
+                y = graph.call_function(torch.ops.aten.slice.Tensor, args=(y, 0, 0, end, 1))
+        y.meta = dict(mm.meta)
+        mm.replace_all_uses_with(y);graph.erase_node(mm);graph.erase_node(gather)
+        matched += 1
+    graph.lint()
+    return matched
+
+
+def rewrite_mxfp8(graph_module, group_name, world_size, hcom, min_tokens, comm_mode):
+    if comm_mode != "ccu":
+        return 0
+    import torch_npu
+    graph = graph_module.graph if hasattr(graph_module,"graph") else graph_module
+    mx_op = torch.ops.npu.npu_dynamic_mx_quant.default
+    qmm_op = torch.ops.npu.npu_quant_matmul.default
+    _normalize_metadata(graph)
+    matched = 0
+    for mm in list(graph.nodes):
+        if mm.op != "call_function" or not _is_op(mm.target, qmm_op) or len(mm.args)<3:
+            continue
+        q, weight, weight_scale = mm.args[:3]
+        scale = mm.kwargs.get("pertoken_scale")
+        if not isinstance(q,torch.fx.Node) or q.target!=operator.getitem or q.args[1]!=0:
+            continue
+        mx=q.args[0]
+        if not _is_op(mx.target,mx_op) or not isinstance(scale,torch.fx.Node) or scale.target!=operator.getitem or scale.args!=(mx,1):
+            continue
+        if len(q.users)!=1 or len(scale.users)!=1 or set(mx.users)!={q,scale}:
+            continue
+        incoming=mx.args[0];crop=_slice_source(incoming)
+        gather,end=(crop if crop else (incoming,None))
+        if not _is_op(gather.target,_AG) or len(gather.users)!=1 or (crop and len(incoming.users)!=1):
+            continue  # another branch still needs the exact BF16 gathered input
+        name=gather.args[3] if len(gather.args)>3 else gather.kwargs.get("group_name")
+        if gather.args[1:3]!=(0,world_size) or name!=group_name:
+            continue
+        kwargs=mx.kwargs
+        if kwargs.get("axis",-1) not in (-1,1) or kwargs.get("block_size",32)!=32 or kwargs.get("scale_alg",0)!=0 or kwargs.get("round_mode","rint")!="rint":
+            continue
+        if mm.kwargs.get("group_sizes") not in ([1,1,32],(1,1,32)) or any(mm.kwargs.get(k) is not None for k in ("bias","offset","y_scale")):
+            continue
+        if any(mm.kwargs.get(k) != torch_npu.float8_e8m0fnu for k in ("scale_dtype","pertoken_scale_dtype")):
+            continue
+        xval=gather.args[0].meta.get("val");wval=weight.meta.get("val");qval=q.meta.get("val");outval=mm.meta.get("val")
+        if not all(isinstance(v,torch.Tensor) for v in (xval,wval,qval,outval)):
+            continue
+        if xval.ndim!=2 or wval.ndim!=2 or xval.dtype not in (torch.bfloat16,torch.float16) or qval.dtype!=torch.float8_e4m3fn or wval.dtype!=qval.dtype or outval.dtype!=xval.dtype:
+            continue
+        if xval.shape[1]!=wval.shape[0] or xval.shape[1]%32!=0:
+            continue
+        nodes=list(graph.nodes);before=nodes[:nodes.index(gather)]
+        if weight not in before or weight_scale not in before:
+            continue
+        if len({n.meta.get("stream_label") for n in [gather,incoming,mx,q,scale,mm]})!=1:
+            continue
+        with graph.inserting_before(gather):
+            result=graph.call_function(torch.ops.vllm.ascend_agmm_mxfp8.default,
+                args=(gather.args[0],weight,weight_scale,32,0,group_name,world_size,hcom,min_tokens,comm_mode))
+        result.meta=_metadata(mm,agmm._mxfp8_fake(xval,wval,weight_scale.meta["val"],32,0,group_name,world_size,hcom,min_tokens,comm_mode))
+        if end is not None:
+            with graph.inserting_before(mm):
+                result=graph.call_function(torch.ops.aten.slice.Tensor,args=(result,0,0,end,1))
+            result.meta=dict(mm.meta)
+        mm.replace_all_uses_with(result);graph.erase_node(mm)
+        for old in [q,scale,mx]+([incoming] if crop else [])+[gather]:
+            if not old.users:graph.erase_node(old)
+        matched+=1
+    graph.lint()
+    return matched
+
+
+class AGMMFusionPass(VllmInductorPass):
+    def __init__(self, config):
+        super().__init__(config)
+        group = get_tp_group();self.group_name = group.unique_name
+        self.world_size = get_tensor_model_parallel_world_size()
+        self.hcom = group.device_group._get_backend(torch.device("npu")).get_hccl_comm_name(group.rank_in_group)
+        sizes = config.compilation_config.cudagraph_capture_sizes or []
+        speculative = getattr(config.speculative_config, "num_speculative_tokens", 0) or 0
+        max_decode = max(sizes) if sizes else config.scheduler_config.max_num_seqs * (1 + speculative)
+        self.min_tokens = max_decode + 1  # derived from the unchanged configuration
+        self.comm_mode = "ccu" if is_950() else "aiv"
+    def __call__(self, graph):
+        self.begin();self.matched_count = rewrite_bf16(graph,self.group_name,self.world_size,self.hcom,self.min_tokens,self.comm_mode)
+        self.matched_count += rewrite_mxfp8(graph,self.group_name,self.world_size,self.hcom,self.min_tokens,self.comm_mode)
+        logger.info("AGMM metadata-v3 graph rewrite: %s projections; GDN auxiliary AG consumers retained",self.matched_count)
+        self.end_and_log()
+    def is_applicable_for_range(self, compile_range):
+        return self.world_size in (2,4,8)
