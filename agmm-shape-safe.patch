+# SPDX-License-Identifier: Apache-2.0
+"""Shape-stable AGMM primitives. Fusion policy stays inside opaque runtime ops.
+
+Unlike the original patch, decoder code never conditionally removes AllGather.
+The BF16 primitive returns the gathered input too, preserving GDN's BA branch.
+"""
+from __future__ import annotations
+import torch
+import torch.nn.functional as F
+import torch_npu
+from vllm.logger import logger
+from vllm.forward_context import get_forward_context
+from vllm.utils.torch_utils import direct_register_custom_op
+
+
+def _runtime_fusion_allowed(x: torch.Tensor, world_size: int, min_tokens: int) -> bool:
+    if world_size not in (2, 4, 8):
+        return False
+    try:
+        context = get_forward_context()
+    except AssertionError:
+        context = None
+    if context is not None and (getattr(context, "in_profile_run", False) or getattr(context, "is_draft_model", False)):
+        return False
+    threshold = min_tokens
+    if context is not None:
+        from vllm_ascend.ascend_forward_context import get_mc2_tokens_capacity
+        capacity = get_mc2_tokens_capacity()
+        if capacity is not None:
+            threshold = max(threshold, capacity + 1)
+    tokens = getattr(context, "num_tokens", None) if context is not None else None
+    if tokens is None:
+        tokens = x.shape[0] * world_size
+    if tokens < threshold:
+        return False
+    # Keep capture/replay on the original collective implementation.
+    return not torch.npu.is_current_stream_capturing()
+
+
+def _gather(x: torch.Tensor, group_name: str, world_size: int) -> torch.Tensor:
+    return torch.ops.vllm.all_gather(x, 0, world_size, group_name=group_name)
+
+
+def _bf16_impl(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor | None,
+               group_name: str, world_size: int, hcom: str, min_tokens: int,
+               comm_mode: str) -> tuple[torch.Tensor, torch.Tensor]:
+    if _runtime_fusion_allowed(x, world_size, min_tokens):
+        logger.info_once("AGMM BF16 eager fusion selected; captured and small-token calls retain original collectives")
+        if comm_mode == "ccu" and callable(getattr(torch_npu, "npu_all_gather_quant_mm", None)):
+            output, gathered, _ = torch_npu.npu_all_gather_quant_mm(
+                x, weight.t(), hcom, world_size, bias=bias, gather_output=True,
+                y_dtype=x.dtype, comm_mode=comm_mode)
+            return output, gathered
+        if comm_mode == "aiv" and callable(getattr(torch_npu, "npu_all_gather_base_mm", None)):
+            return torch_npu.npu_all_gather_base_mm(
+                x, weight.t(), hcom, world_size, bias=bias, gather_index=0,
+                gather_output=True, comm_turn=0, output_dtype=x.dtype, comm_mode=comm_mode)
+    gathered = _gather(x, group_name, world_size)
+    return F.linear(gathered, weight, bias), gathered
+
+
+def _bf16_fake(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor | None,
+               group_name: str, world_size: int, hcom: str, min_tokens: int,
+               comm_mode: str) -> tuple[torch.Tensor, torch.Tensor]:
+    # Tensor metadata only: no ForwardContext, layer registry, HCCL or device query.
+    rows = x.shape[0] * world_size
+    return x.new_empty((rows, weight.shape[0])), x.new_empty((rows, x.shape[1]))
+
+
+def _mxfp8_impl(x: torch.Tensor, weight: torch.Tensor, weight_scale: torch.Tensor,
+                 group_size: int, scale_alg: int, group_name: str, world_size: int,
+                 hcom: str, min_tokens: int, comm_mode: str) -> torch.Tensor:
+    can_fuse = (_runtime_fusion_allowed(x, world_size, min_tokens)
+                and comm_mode == "ccu" and callable(getattr(torch_npu, "npu_all_gather_quant_mm", None)))
+    if can_fuse:
+        quantized, scale = torch_npu.npu_dynamic_mx_quant(
+            x, dst_type=torch.float8_e4m3fn, scale_alg=scale_alg)
+        output, _, _ = torch_npu.npu_all_gather_quant_mm(
+            quantized, weight, hcom, world_size, x1_scale=scale, x2_scale=weight_scale,
+            x1_dtype=torch.float8_e4m3fn, x2_dtype=torch.float8_e4m3fn,
+            x1_scale_dtype=torch_npu.float8_e8m0fnu, x2_scale_dtype=torch_npu.float8_e8m0fnu,
+            y_dtype=x.dtype, group_sizes=[1, 1, group_size], gather_output=False,
+            comm_mode=comm_mode)
+        return output
+    # No BF16-kernel fallback for FP8 weights: retain the original quantized math.
+    gathered = _gather(x, group_name, world_size)
+    quantized, scale = torch_npu.npu_dynamic_mx_quant(
+        gathered, dst_type=torch.float8_e4m3fn, scale_alg=scale_alg)
+    return torch_npu.npu_quant_matmul(
+        quantized, weight, weight_scale, scale_dtype=torch_npu.float8_e8m0fnu,
+        pertoken_scale=scale, pertoken_scale_dtype=torch_npu.float8_e8m0fnu,
+        output_dtype=x.dtype, group_sizes=[1, 1, group_size])
+
+
+def _mxfp8_fake(x: torch.Tensor, weight: torch.Tensor, weight_scale: torch.Tensor,
+                 group_size: int, scale_alg: int, group_name: str, world_size: int,
+                 hcom: str, min_tokens: int, comm_mode: str) -> torch.Tensor:
+    return x.new_empty((x.shape[0] * world_size, weight.shape[1]))
+
+
+direct_register_custom_op("ascend_agmm_bf16", _bf16_impl, mutates_args=[],
+                          fake_impl=_bf16_fake, dispatch_key="PrivateUse1")
+direct_register_custom_op("ascend_agmm_mxfp8", _mxfp8_impl, mutates_args=[],
+                          fake_impl=_mxfp8_fake, dispatch_key="PrivateUse1")
